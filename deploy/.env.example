# ============================================================
# AI 私人医生系统 — 全量环境变量样例（deploy/.env.example）
# 用法：cp .env.example .env 后修改；生产环境务必更换全部密钥。
# 约定：镜像内零硬编码配置，全部经 env 注入（AC-15.3）。
# ============================================================

# --- 运行环境 ---
APP_ENV=prod                                  # prod/dev/test

# --- 数据库（PostgreSQL 16 + pgvector）---
DATABASE_URL=postgresql+psycopg://aiuser:aipass@postgres:5432/aidoctor
POSTGRES_USER=aiuser
POSTGRES_PASSWORD=aipass
POSTGRES_DB=aidoctor

# --- Redis 7（任务队列/缓存/限流/最近会话）---
REDIS_URL=redis://redis:6379/0

# --- MinIO（原件证据层，S3 兼容）---
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000       # 浏览器访问签名 URL；集群填外部 S3/Ingress 地址
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medical-docs
MINIO_SECURE=false

# --- 认证（JWT）---
JWT_SECRET=change-me-to-at-least-32-bytes-random-secret   # 必填，≥32 字节随机；生产必须更换
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=10080                     # 默认 7 天

# --- LLM 网关（OpenAI 兼容；base_url 可指向 NewAPI/Ollama/直连）---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-change-me                     # 仅 env，不入库不下发
LLM_MODEL=gpt-4o-mini                        # 回答模型
LLM_VLM_MODEL=gpt-4o                         # 抽取（VLM）模型
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1                            # E-5：失败重试 1 次
LOCAL_MODEL_MODE=false                       # true=本地 base_url，出域策略切换

# --- 隐私与 HITL ---
PII_MASKING_ENABLED=true                     # A-4 出域脱敏
HITL_CONFIDENCE_THRESHOLD=0.85               # P0 仅用于高亮（全部强制确认）
AUTO_COMMIT_ENABLED=false                    # P1 留缝，P0 恒 false

# --- 上传与抽取 ---
MAX_UPLOAD_MB=20                             # E-10 单文件上限
EXTRACT_MAX_ATTEMPTS=2                       # 含首次（E-1 重试 1 次）
QUEUE_EXTRACT=queue:extract
SIGN_URL_EXPIRE_SECONDS=600                  # E-9 原件链接时效
REDFLAG_RELOAD_TTL_SECONDS=60                # 红旗规则热更新轮询

# --- 日志与观测 ---
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:5173           # dev；prod 同源由 nginx 收敛

# --- 限流 ---
RATE_LIMIT_CHAT_PER_MIN=20

# --- Compose 端口 ---
WEB_PORT=8080
API_PORT=8000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- 前端构建期 env（仅 base 路径，不含任何密钥）---
VITE_API_BASE=/api

# --- 邮件通知（配置变更告警）---
# 密码/授权码只填在这里（.env 已被 .gitignore 忽略），不得写入源码或文档
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_TIMEOUT_SECONDS=10

# --- 系统配置写权限（admin_only | first_account | any）---
CONFIG_WRITE_POLICY=admin_only
CONFIG_ADMIN_EMAILS=